<file path="src/App.css">
@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap");

:root {
  font-family: "DM Sans", sans-serif;
  color: #17271e;
  background: #faf9f5;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;

  --paper: #faf9f5;
  --white: #fffefa;
  --ink: #17271e;
  --forest: #173c2b;
  --forest-deep: #102d21;
  --muted: #727a70;
  --line: #e7e7dd;
  --lime: #d7f36a;
  --lime-dark: #c6e754;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  min-width: 320px;
}

body,
button,
a {
  font-family: "DM Sans", sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  color: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
a:focus-visible {
  outline: 3px solid #a6cc42;
  outline-offset: 5px;
}

img {
  display: block;
  width: 100%;
}

::selection {
  color: var(--forest-deep);
  background: var(--lime);
}

.site-shell {
  width: 100%;
  overflow: clip;
  background: var(--paper);
}

.announcement {
  min-height: 38px;
  padding: 8px 5%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  background: var(--forest-deep);
  color: #e5ecdf;
  font-size: 11px;
  letter-spacing: 0.015em;
}

.announcement-star {
  color: var(--lime);
  font-size: 14px;
}

.announcement a {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-left: 8px;
  color: var(--lime);
  font-weight: 600;
}

.announcement a svg {
  width: 12px;
  height: 12px;
  transition: transform 0.2s;
}

.announcement a:hover svg {
  transform: translateX(3px);
}

.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid rgba(23, 39, 30, 0.08);
  background: rgba(250, 249, 245, 0.94);
  backdrop-filter: blur(18px);
}

.nav-inner {
  max-width: 1440px;
  min-height: 82px;
  padding: 0 7%;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.brand-symbol {
  width: 29px;
  height: 29px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 3px;
  transform: rotate(-8deg);
}

.brand-symbol span {
  border-radius: 2px 6px 2px 6px;
  background: var(--forest);
}

.brand-symbol span:nth-child(2) {
  background: #87a84b;
  border-radius: 6px 2px 6px 2px;
}

.brand-symbol span:nth-child(3) {
  background: #a6c84f;
  border-radius: 6px 2px 6px 2px;
}

.brand-symbol span:nth-child(4) {
  background: var(--forest);
}

.brand-name {
  font-family: "Manrope", sans-serif;
  font-size: 27px;
  font-weight: 800;
  letter-spacing: -1.8px;
}

.brand-name > span {
  color: #71953c;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: clamp(20px, 3vw, 42px);
  font-size: 12px;
  font-weight: 600;
  color: #58635a;
}

.nav-links > a:not(.nav-cta) {
  transition: color 0.2s;
}

.nav-links > a:not(.nav-cta):hover {
  color: #71953c;
}

.nav-cta {
  min-height: 44px;
  padding: 0 17px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
  color: var(--white);
  background: var(--forest);
  border-radius: 4px;
  transition: background 0.2s, transform 0.2s;
}

.nav-cta:hover {
  background: #29563c;
  transform: translateY(-1px);
}

.nav-cta svg {
  width: 15px;
  height: 15px;
}

.menu-toggle {
  display: none;
}

.hero {
  position: relative;
  background:
    radial-gradient(ellipse at 74% 43%, rgba(215, 231, 176, 0.2), transparent 36%),
    var(--paper);
}

.hero-inner {
  max-width: 1440px;
  min-height: 680px;
  padding: 83px 7% 78px;
  margin: auto;
  display: grid;
  grid-template-columns: 1.02fr 0.98fr;
  align-items: center;
  gap: 35px;
}

.hero-copy {
  position: relative;
  z-index: 2;
  padding-bottom: 12px;
  animation: fade-up 0.7s ease both;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 11px;
  color: #697b56;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.15em;
  line-height: 1.6;
}

.section-label > span:first-child {
  color: #91a17a;
  font-size: 10px;
  letter-spacing: 0;
}

.label-line {
  width: 27px;
  height: 1px;
  background: #a9b69a;
}

.hero h1 {
  margin: 31px 0 25px;
  font-family: "Manrope", sans-serif;
  font-size: clamp(56px, 6.1vw, 88px);
  font-weight: 600;
  letter-spacing: -0.078em;
  line-height: 0.99;
}

.hero-highlight {
  color: #729146;
}

.hero-description {
  max-width: 450px;
  margin: 0;
  color: #697168;
  font-size: 15px;
  line-height: 1.95;
}

.hero-actions {
  margin-top: 31px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 25px;
}

.button {
  min-height: 51px;
  padding: 0 19px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 22px;
  border: 1px solid transparent;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 700;
  transition: transform 0.2s, background 0.2s, border-color 0.2s;
}

.button:hover {
  transform: translateY(-2px);
}

.button svg {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.button-primary {
  color: white;
  background: var(--forest);
}

.button-primary:hover {
  background: #28583b;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #465448;
  font-size: 12px;
  font-weight: 600;
}

.text-link svg {
  width: 15px;
  height: 15px;
  transition: transform 0.2s;
}

.text-link:hover svg {
  transform: translate(2px, -2px);
}

.hero-proof {
  margin-top: 49px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.proof-icon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  color: var(--forest);
  background: #edf0e3;
  border-radius: 50%;
  font-size: 19px;
}

.hero-proof p {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin: 0;
}

.hero-proof strong {
  font-size: 11px;
  font-weight: 700;
}

.hero-proof p span {
  color: #8a9086;
  font-size: 10px;
}

.hero-visual {
  position: relative;
  min-width: 0;
  min-height: 505px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.visual-glow {
  position: absolute;
  width: 410px;
  height: 410px;
  border-radius: 50%;
  background: radial-gradient(circle, #e8edda 0%, #f0f1e6 47%, transparent 70%);
}

.visual-orbit {
  position: absolute;
  width: 410px;
  height: 410px;
  border: 1px solid rgba(101, 126, 75, 0.12);
  border-radius: 50%;
}

.orbit-two {
  width: 485px;
  height: 485px;
  border-style: dashed;
  border-color: rgba(101, 126, 75, 0.12);
  animation: orbit-rotate 80s linear infinite;
}

.demo-window {
  position: relative;
  z-index: 3;
  width: min(100%, 390px);
  border: 1px solid rgba(26, 49, 33, 0.12);
  border-radius: 13px;
  background: #fffefa;
  box-shadow:
    0 35px 80px -35px rgba(24, 49, 31, 0.25),
    0 4px 14px rgba(24, 49, 31, 0.04);
  overflow: hidden;
  animation: fade-up 0.8s 0.12s ease both;
}

.demo-topbar {
  min-height: 73px;
  padding: 0 19px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #eceee5;
}

.demo-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.demo-avatar {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  color: white;
  background: var(--forest);
  border-radius: 10px;
  font-family: "Manrope", sans-serif;
  font-size: 17px;
  font-weight: 800;
}

.demo-brand > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.demo-brand strong {
  font-size: 12px;
}

.demo-brand > div:last-child span {
  color: #93998e;
  font-size: 9px;
}

.live-indicator {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #8b9285;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.07em;
}

.live-indicator i,
.caption-dot {
  width: 6px;
  height: 6px;
  display: inline-block;
  background: #9ab84e;
  border-radius: 50%;
}

.demo-conversation {
  min-height: 343px;
  padding: 23px 20px 15px;
  background:
    radial-gradient(ellipse at 80% 10%, rgba(234, 239, 219, 0.25), transparent 55%),
    #fffefa;
}

.demo-date {
  margin-bottom: 24px;
  color: #9ba093;
  text-align: center;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.11em;
}

.message {
  max-width: 94%;
  margin-bottom: 21px;
  padding: 13px 14px;
  border-radius: 9px;
}

.message-label {
  display: block;
  margin-bottom: 8px;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.07em;
}

.message p {
  margin: 0;
  font-size: 11px;
  line-height: 1.8;
}

.message-user {
  margin-left: auto;
  color: #fff;
  background: var(--forest);
  border-bottom-right-radius: 2px;
}

.message-user .message-label {
  color: #d1e0ce;
}

.message-ai {
  color: #293b2e;
  background: #f0f2e9;
  border: 1px solid #e9ecdf;
  border-bottom-left-radius: 2px;
}

.message-ai .message-label {
  color: #78904e;
}

.message-footer {
  margin-top: 11px;
  padding-top: 9px;
  display: flex;
  align-items: center;
  gap: 5px;
  border-top: 1px solid #e1e6d7;
  color: #87917c;
  font-size: 8px;
}

.mini-spark {
  color: #8ca64b;
  font-size: 12px;
}

.demo-reply {
  min-height: 39px;
  margin-top: 4px;
  padding: 0 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1px solid #e5e8dd;
  border-radius: 5px;
  color: #a0a598;
  font-size: 10px;
}

.reply-arrow {
  color: var(--forest);
  font-size: 17px;
}

.demo-bottom {
  min-height: 75px;
  padding: 14px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-top: 1px solid #eceee5;
  background: #fafbf6;
}

.demo-bottom-icon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border-radius: 9px;
  background: #e7efd3;
  color: var(--forest);
  font-size: 19px;
}

.demo-bottom > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.demo-bottom strong {
  font-size: 10px;
}

.demo-bottom span {
  color: #8b9186;
  font-size: 9px;
}

.visual-note {
  position: absolute;
  z-index: 4;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255, 254, 250, 0.94);
  border: 1px solid rgba(26, 49, 33, 0.08);
  border-radius: 7px;
  box-shadow: 0 10px 35px rgba(26, 49, 33, 0.07);
  backdrop-filter: blur(8px);
}

.note-top {
  top: 35px;
  right: -8px;
}

.note-bottom {
  bottom: 33px;
  left: -18px;
}

.note-icon {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  border-radius: 6px;
  background: #edf0e5;
  color: var(--forest);
  font-family: "Manrope", sans-serif;
  font-size: 13px;
  font-weight: 800;
}

.note-icon-lime {
  background: var(--lime);
}

.visual-note > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.visual-note strong {
  font-size: 10px;
}

.visual-note > div:last-child span {
  color: #8d9487;
  font-size: 9px;
}

.visual-coordinate {
  position: absolute;
  right: 4px;
  bottom: 0;
  color: #9ca28f;
  font-size: 8px;
  letter-spacing: 0.12em;
}

.hero-bottom {
  min-height: 48px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid var(--line);
  color: #92968b;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.hero-bottom a {
  display: inline-flex;
  align-items: center;
  gap: 9px;
}

.scroll-line {
  width: 23px;
  height: 1px;
  background: #99a58a;
}

.section-padding {
  padding-left: 7%;
  padding-right: 7%;
}

.mission {
  max-width: 1440px;
  margin: 0 auto;
  padding-top: 118px;
  padding-bottom: 120px;
}

.mission-heading h2,
.how-heading h2,
.applications-heading h2,
.contact-copy h2 {
  margin: 25px 0 48px;
  font-family: "Manrope", sans-serif;
  font-size: clamp(36px, 4.3vw, 59px);
  font-weight: 600;
  letter-spacing: -0.065em;
  line-height: 1.15;
}

.mission-heading h2 span,
.applications-heading h2 span,
.contact-copy h2 span {
  color: #8b9b79;
}

.mission-grid {
  display: grid;
  grid-template-columns: 1fr 0.88fr;
  align-items: stretch;
  gap: clamp(40px, 8vw, 112px);
}

.mission-image {
  position: relative;
  min-height: 470px;
  overflow: hidden;
  border-radius: 5px;
  background: #e7e9df;
}

.mission-image::after,
.application-image::after {
  position: absolute;
  inset: 0;
  content: "";
  background: linear-gradient(
    180deg,
    rgba(10, 25, 16, 0.03) 15%,
    rgba(10, 25, 16, 0.07) 45%,
    rgba(10, 25, 16, 0.64) 100%
  );
  pointer-events: none;
}

.mission-image img {
  height: 100%;
  min-height: 470px;
  object-fit: cover;
  transition: transform 0.7s ease;
}

.mission-image:hover img,
.application-card:hover .application-image img {
  transform: scale(1.045);
}

.image-caption {
  position: absolute;
  z-index: 2;
  top: 20px;
  left: 20px;
  padding: 10px 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: white;
  background: rgba(20, 42, 29, 0.67);
  border-radius: 3px;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.09em;
  backdrop-filter: blur(8px);
}

.image-statement {
  position: absolute;
  z-index: 2;
  bottom: 29px;
  left: 29px;
  color: white;
  font-family: "Manrope", sans-serif;
  font-size: clamp(29px, 3.5vw, 43px);
  font-weight: 600;
  letter-spacing: -0.06em;
  line-height: 1.12;
}

.mission-content {
  padding-top: 9px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.eyebrow {
  color: #82936e;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.15em;
}

.mission-content h3 {
  margin: 20px 0;
  font-family: "Manrope", sans-serif;
  font-size: clamp(24px, 2.5vw, 33px);
  font-weight: 600;
  letter-spacing: -0.045em;
  line-height: 1.35;
}

.mission-content > p {
  margin: 0 0 17px;
  color: #71796f;
  font-size: 12px;
  line-height: 2;
}

.underlined-link {
  margin-top: 10px;
  padding-bottom: 7px;
  display: inline-flex;
  align-items: center;
  gap: 15px;
  border-bottom: 1px solid #aab49e;
  font-size: 11px;
  font-weight: 700;
}

.underlined-link svg {
  width: 15px;
  height: 15px;
  transition: transform 0.2s;
}

.underlined-link:hover svg {
  transform: translateX(4px);
}

.mission-principles {
  width: 100%;
  margin-top: auto;
  padding-top: 32px;
  display: grid;
  gap: 0;
}

.mission-principles > div {
  padding: 15px 0;
  display: flex;
  align-items: center;
  gap: 17px;
  border-top: 1px solid var(--line);
}

.mission-principles span {
  color: #9aab81;
  font-size: 9px;
}

.mission-principles strong {
  font-size: 11px;
  font-weight: 600;
}

.how-section {
  padding-top: 108px;
  padding-bottom: 80px;
  color: #fffefa;
  background: var(--forest-deep);
}

.section-label-light {
  color: #b5c7a2;
}

.section-label-light > span:first-child {
  color: #91ad77;
}

.section-label-light .label-line {
  background: #60795d;
}

.how-heading,
.applications-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 50px;
}

.how-heading h2 {
  margin-bottom: 0;
}

.how-heading h2 span {
  color: #b9cb9e;
}

.how-heading > p,
.applications-heading > p {
  max-width: 310px;
  margin: 0 0 6px;
  color: #a9b7a8;
  font-size: 12px;
  line-height: 1.9;
}

.steps-grid {
  margin-top: 65px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border: 1px solid rgba(240, 245, 231, 0.15);
}

.step-card {
  min-width: 0;
  padding: 24px 25px 30px;
  border-right: 1px solid rgba(240, 245, 231, 0.15);
  transition: background 0.25s;
}

.step-card:last-child {
  border-right: 0;
}

.step-card:hover {
  background: rgba(255, 255, 255, 0.035);
}

.step-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #a8b99b;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.step-symbol {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(235, 242, 222, 0.2);
  border-radius: 50%;
  color: var(--lime);
  font-size: 15px;
}

.step-illustration {
  position: relative;
  height: 177px;
  margin: 24px 0 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 50% 55%, rgba(211, 237, 150, 0.1), transparent 68%),
    rgba(255, 255, 255, 0.035);
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 3px;
}

.sms-illustration {
  flex-direction: column;
  align-items: flex-start;
  gap: 13px;
  padding: 23px;
}

.illustration-bubble {
  padding: 12px 15px;
  color: #e7eddf;
  background: #31553b;
  border: 1px solid rgba(215, 243, 106, 0.08);
  border-radius: 8px 8px 8px 2px;
  font-size: 10px;
}

.bubble-right {
  align-self: flex-end;
  color: #17271e;
  background: var(--lime);
  border-radius: 8px 8px 2px 8px;
}

.illustration-sms {
  position: absolute;
  top: 13px;
  right: 14px;
  color: rgba(235, 244, 224, 0.38);
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.13em;
}

.ai-ring {
  position: absolute;
  width: 122px;
  height: 122px;
  border: 1px solid rgba(215, 243, 106, 0.33);
  border-radius: 50%;
}

.ring-a {
  transform: scaleX(0.53);
}

.ring-b {
  transform: scaleY(0.53);
}

.ai-core {
  width: 66px;
  height: 66px;
  display: grid;
  place-items: center;
  color: var(--forest-deep);
  background: var(--lime);
  border-radius: 21px;
  box-shadow: 0 0 40px rgba(215, 243, 106, 0.12);
  font-family: "Manrope", sans-serif;
  font-size: 28px;
  font-weight: 800;
}

.ai-orbit-label {
  position: absolute;
  top: 28px;
  right: 29%;
  color: #b8c9a4;
  font-size: 8px;
  letter-spacing: 0.1em;
}

.answer-illustration {
  flex-direction: column;
  align-items: flex-start;
  gap: 11px;
  padding: 30px 35px;
}

.answer-spark {
  margin-bottom: 5px;
  color: var(--lime);
  font-size: 22px;
}

.answer-line {
  width: 76%;
  height: 5px;
  border-radius: 5px;
  background: #647d61;
}

.line-long {
  width: 95%;
  background: #9fb77e;
}

.line-short {
  width: 54%;
}

.answer-check {
  position: absolute;
  right: 24px;
  bottom: 22px;
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  color: var(--forest-deep);
  background: var(--lime);
  border-radius: 50%;
  font-size: 13px;
}

.step-card h3 {
  margin: 0 0 12px;
  font-family: "Manrope", sans-serif;
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.step-card > p {
  max-width: 300px;
  margin: 0;
  color: #b0bcb0;
  font-size: 11px;
  line-height: 1.9;
}

.how-footnote {
  margin-top: 24px;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: #a7b5a4;
}

.how-footnote > span {
  color: var(--lime);
}

.how-footnote p {
  margin: 0;
  font-size: 9px;
  line-height: 1.8;
}

.applications {
  padding-top: 118px;
  padding-bottom: 122px;
}

.applications-heading {
  margin-bottom: 49px;
}

.applications-heading h2 {
  margin-bottom: 0;
}

.applications-heading > p {
  color: #788074;
}

.applications-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.application-card {
  min-width: 0;
}

.application-image {
  position: relative;
  height: clamp(210px, 25vw, 315px);
  overflow: hidden;
  border-radius: 4px;
  background: #e5e8dc;
}

.application-image img {
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s ease;
}

.application-number {
  position: absolute;
  z-index: 2;
  top: 16px;
  left: 16px;
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  color: white;
  font-size: 9px;
  backdrop-filter: blur(6px);
}

.application-tag {
  position: absolute;
  z-index: 2;
  left: 17px;
  bottom: 18px;
  color: white;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.application-arrow {
  position: absolute;
  z-index: 2;
  right: 15px;
  bottom: 13px;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  color: var(--forest);
  background: white;
  border-radius: 50%;
  transition: background 0.2s, transform 0.2s;
}

.application-card:hover .application-arrow {
  background: var(--lime);
  transform: rotate(5deg);
}

.application-arrow svg {
  width: 15px;
  height: 15px;
}

.application-copy {
  padding-top: 21px;
}

.application-copy h3 {
  margin: 0 0 10px;
  font-family: "Manrope", sans-serif;
  font-size: 22px;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.application-copy p {
  max-width: 340px;
  margin: 0;
  color: #747c71;
  font-size: 11px;
  line-height: 1.9;
}

.applications-note {
  margin-top: 32px;
  color: #969a90;
  font-size: 9px;
  line-height: 1.7;
}

.belief-section {
  position: relative;
  overflow: hidden;
  color: white;
  background: var(--forest);
}

.belief-inner {
  position: relative;
  min-height: 485px;
  padding: 100px 7%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.belief-mark {
  position: absolute;
  top: 33px;
  left: 50%;
  color: rgba(215, 243, 106, 0.18);
  font-family: Georgia, serif;
  font-size: 170px;
  line-height: 1;
  transform: translateX(-50%);
}

.belief-inner > .section-label {
  position: relative;
  z-index: 1;
}

.belief-inner h2 {
  position: relative;
  z-index: 1;
  margin: 28px 0 21px;
  font-family: "Manrope", sans-serif;
  font-size: clamp(42px, 5.5vw, 72px);
  font-weight: 600;
  letter-spacing: -0.07em;
  line-height: 1.1;
}

.belief-inner h2 span {
  color: var(--lime);
}

.belief-inner > p {
  position: relative;
  z-index: 1;
  max-width: 480px;
  margin: 0;
  color: #c0cdc0;
  font-size: 12px;
  line-height: 1.9;
}

.button-light {
  position: relative;
  z-index: 1;
  margin-top: 30px;
  color: var(--forest-deep);
  background: var(--lime);
}

.button-light:hover {
  background: #e5f8a5;
}

.belief-decoration {
  position: absolute;
  top: 50%;
  left: 50%;
  width: min(680px, 90%);
  height: 380px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  opacity: 0.11;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.belief-decoration span {
  width: 1px;
  height: 100%;
  background: #d7f36a;
  transform: rotate(20deg);
}

.belief-decoration span:nth-child(even) {
  transform: rotate(-20deg);
}

.contact-section {
  max-width: 1440px;
  margin: 0 auto;
  padding-top: 120px;
  padding-bottom: 120px;
  display: grid;
  grid-template-columns: 1fr 0.8fr;
  align-items: center;
  gap: clamp(50px, 9vw, 135px);
}

.contact-copy h2 {
  margin-bottom: 25px;
}

.contact-copy > p {
  max-width: 440px;
  margin: 0;
  color: #72796e;
  font-size: 13px;
  line-height: 2;
}

.contact-panel {
  padding: 32px;
  border: 1px solid #e7e9df;
  border-radius: 5px;
  background: #fffefa;
  box-shadow: 0 20px 50px rgba(30, 49, 32, 0.035);
}

.contact-panel-label {
  color: #85936e;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
}

